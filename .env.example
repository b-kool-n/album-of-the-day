# Copy to .env.local for local development. On Vercel, add these under Project Settings > Environment Variables.

# Supabase (Project Settings > API). The publishable key is safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Spotify Web API app (developer.spotify.com/dashboard). Secret: server only.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm API key (last.fm/api), used to suggest the most-played song. Optional.
LASTFM_API_KEY=

# Copy to .env.local for local development. On Vercel, add these under Project Settings > Environment Variables.

# Supabase (Project Settings > API). The publishable key is safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Spotify Web API app (developer.spotify.com/dashboard). Secret: server only.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm API key (last.fm/api), used to suggest the most-played song. Optional.
LASTFM_API_KEY=

# Supabase secret key (Project Settings > API Keys > Secret keys). Server only: needed for daily
# notifications and account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: any long random string. If set, only Vercel's scheduler can trigger the daily notification.
CRON_SECRET=

# Optional: set to 1 once Apple sign-in is set up for the website (Services ID and key in Supabase).
# The iPhone app's Apple sign-in doesn't need this.
WEB_APPLE_SIGNIN=
